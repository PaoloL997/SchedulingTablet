<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brembana.ActivitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Brembana"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="24">
            <Button x:Name="BackButton"
                    Click="Back_Click"
                    MinWidth="200"
                    Height="56"
                    HorizontalAlignment="Left"
                    CornerRadius="14"
                    BorderBrush="#FF3B424E"
                    BorderThickness="1"
                    Background="#FF232830"
                    ToolTipService.ToolTip="Torna alla home">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE72B;" FontSize="22"/>
                    <TextBlock x:Name="BackButtonText" Text="Torna alla home" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="CommessaTitleText"
                       VerticalAlignment="Center"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#FFE8EAED"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FF232830" BorderBrush="#FF3B424E" BorderThickness="1"
                CornerRadius="16" Height="68" Padding="20,0" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="#FF848B96" VerticalAlignment="Center"/>
                <AutoSuggestBox x:Name="ActivitySearchBox" Grid.Column="1"
                                PlaceholderText="Cerca attività"
                                TextChanged="ActivitySearchBox_TextChanged"
                                SuggestionChosen="ActivitySearchBox_SuggestionChosen"
                                QuerySubmitted="ActivitySearchBox_QuerySubmitted"
                                Background="Transparent" BorderThickness="0"
                                FontSize="20" VerticalAlignment="Center">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:AttivitaDto">
                            <TextBlock Text="{x:Bind ActivityId}" FontSize="18" Foreground="#FFE8EAED"/>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,8,10,12">
            <StackPanel x:Name="ActivityCardsPanel" Spacing="2" HorizontalAlignment="Stretch" Padding="0,2"/>
        </ScrollViewer>

        <ProgressRing Grid.Row="2" x:Name="LoadingRing" IsActive="False" Width="44" Height="44"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Page>
