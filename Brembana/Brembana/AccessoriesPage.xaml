<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brembana.AccessoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="84" Padding="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="Back_Click" Width="72" Height="72"
                    CornerRadius="14" BorderBrush="#FF3B424E" BorderThickness="1"
                    Background="#FF232830" HorizontalAlignment="Left"
                    ToolTipService.ToolTip="Indietro">
                <FontIcon Glyph="&#xE72B;" FontSize="26"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                <TextBlock x:Name="SessionTitle"
                           FontSize="28" FontWeight="Bold" Foreground="#FFE8EAED"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <TextBlock x:Name="SessionSubtitle"
                               FontSize="16" Foreground="#FF848B96"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    <Border x:Name="SessionModeBadge" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="SessionModeText" FontSize="14" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Click="Photo_Click" Height="56" MinWidth="110"
                    Padding="16,0" CornerRadius="14"
                    BorderBrush="#FF3B424E" BorderThickness="1" Background="#FF232830"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Identifica da foto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE722;" FontSize="20"/>
                    <TextBlock Text="Foto" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8,10,12">
            <StackPanel x:Name="ComponentsPanel" Spacing="2" Padding="0,2"/>
        </ScrollViewer>

        <Button Grid.Row="2" x:Name="BtnRegister" Click="Save_Click"
                Height="64" MinWidth="360" MaxWidth="520"
                HorizontalAlignment="Center" CornerRadius="14" Padding="32,0"
                BorderThickness="0">
            <TextBlock x:Name="BtnRegisterText" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Button>

        <ProgressRing Grid.Row="1" x:Name="BusyRing" IsActive="False" Width="44" Height="44"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Page>
