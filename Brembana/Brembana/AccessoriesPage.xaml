<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brembana.AccessoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Testata: indietro, nome attività con il verso accanto, stabilimento e responsabile sotto -->
        <Grid Grid.Row="0" MinHeight="68">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="Back_Click" Width="64" Height="64"
                    CornerRadius="14" BorderBrush="#FF3B424E" BorderThickness="1"
                    Background="#FF232830" HorizontalAlignment="Left"
                    ToolTipService.ToolTip="Indietro">
                <FontIcon Glyph="&#xE72B;" FontSize="24"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <TextBlock x:Name="SessionTitle"
                               FontSize="26" FontWeight="Bold" Foreground="#FFE8EAED"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                    <Border x:Name="SessionModeBadge" CornerRadius="8" Padding="13,6" VerticalAlignment="Center">
                        <TextBlock x:Name="SessionModeText" FontSize="17" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SessionSubtitle"
                           FontSize="17" Foreground="#FF848B96"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="520"/>
            </StackPanel>
        </Grid>

        <!-- Riepilogo: una riga per categoria, riempita da MainWindow.FillComponentsPanel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,6,0,0">
            <StackPanel x:Name="ComponentsPanel"/>
        </ScrollViewer>

        <TextBlock x:Name="CodeErrorText"
                   Grid.Row="2"
                   Margin="24,0,24,0"
                   FontSize="19" FontWeight="SemiBold"
                   TextWrapping="WrapWholeWords"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Barra azioni: la scansione di controllo e, grande, il tasto che avvia o chiude -->
        <Grid Grid.Row="3" Height="96" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ScanButton" Grid.Column="0" Click="Scan_Click"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="16"
                    BorderBrush="#FF3B424E" BorderThickness="1" Background="#FF232830"
                    ToolTipService.ToolTip="Riprendi la scansione con la fotocamera">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE722;" FontSize="26"/>
                    <TextBlock x:Name="ScanButtonText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnRegister" Grid.Column="1" Click="Save_Click"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="16"
                    BorderThickness="0">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="BtnRegisterText" FontSize="30" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BtnRegisterDetail" FontSize="17" FontWeight="SemiBold"
                               Foreground="White" Opacity="0.88" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ProgressRing Grid.Row="1" x:Name="BusyRing" IsActive="False" Width="44" Height="44"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Page>
