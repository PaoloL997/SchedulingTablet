<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Brembana.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Brembana"
    Title="Brembana - Gestione Magazzino">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#FF111318">
        <Grid x:Name="AppContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,14,20,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Long-press 5s per accesso amministratore kiosk (anche dalle altre pagine) -->
            <StackPanel x:Name="AdminBrandHotspot" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Background="Transparent"
                        ToolTipService.ToolTip="">
                <TextBlock Text="Brembana&amp;Rolle" FontSize="18" FontWeight="Bold" Foreground="#FFE8EAED"
                           IsHitTestVisible="False"/>
                <TextBlock Text="/" FontSize="18" Foreground="#FF5C6370" IsHitTestVisible="False"/>
                <TextBlock Text="Gestione Magazzino" FontSize="18" FontWeight="SemiBold" Foreground="#FF848B96"
                           IsHitTestVisible="False"/>
            </StackPanel>
            <StackPanel x:Name="LoggedInUserPanel" Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="36" Height="36" CornerRadius="18" Background="#FF2D333D"
                        BorderBrush="#FF3B424E" BorderThickness="1">
                    <TextBlock x:Name="UserAvatarText" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FFE8EAED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="LoggedInUserText" FontSize="16" Foreground="#FF848B96" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" Padding="24,0,24,16"/>

        <Grid Grid.Row="2" Margin="20,0,20,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Left"
                    Background="#FF232830" BorderBrush="#FF3B424E"
                    BorderThickness="1" CornerRadius="22" Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#FFF29F0D"
                             VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Avvio..." FontSize="16" FontWeight="SemiBold"
                               Foreground="#FFE8EAED" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Button x:Name="BtnRefreshDataset" Grid.Column="1" Click="RefreshDataset_Click"
                    Height="52" MinWidth="140" Padding="20,0" CornerRadius="12"
                    BorderBrush="#FF3B424E" BorderThickness="1" Background="#FF232830"
                    HorizontalAlignment="Right"
                    ToolTipService.ToolTip="Ricarica attività e accessori dal server">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE72C;" FontSize="20" Foreground="#FF4D9EF7"/>
                    <TextBlock Text="Aggiorna" FontSize="17" FontWeight="SemiBold" Foreground="#FFE8EAED"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid x:Name="SavingOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#80000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock x:Name="SavingText" Text="Elaborazione..." FontSize="17" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ToastBar" Grid.RowSpan="3" IsOpen="False" IsClosable="False"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,16,0,0" CornerRadius="8" IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="CameraCaptureOverlay" Visibility="Collapsed" Background="Black">
            <Grid x:Name="CameraPreviewHost" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                </Grid.RenderTransform>
                <MediaPlayerElement x:Name="CameraPreviewElement"
                                    AreTransportControlsEnabled="False"
                                    Stretch="UniformToFill"
                                    ManipulationMode="None"/>
            </Grid>

            <Canvas x:Name="CameraScanGuideHost" IsHitTestVisible="False" Visibility="Collapsed">
                <Border x:Name="CameraScanGuideDimTop" Background="#80000000"/>
                <Border x:Name="CameraScanGuideDimBottom" Background="#80000000"/>
                <Border x:Name="CameraScanGuideDimLeft" Background="#80000000"/>
                <Border x:Name="CameraScanGuideDimRight" Background="#80000000"/>
                <Border x:Name="CameraScanGuideFrame"
                        Background="Transparent"
                        BorderBrush="#FFE02424"
                        BorderThickness="3"/>
            </Canvas>

            <ScrollViewer x:Name="CameraComponentListHost"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Width="360"
                          MaxHeight="520"
                          Margin="20,56,0,140"
                          Background="Transparent"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CameraComponentList" Spacing="14"/>
            </ScrollViewer>

            <TextBlock x:Name="CameraVisionModelText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,20,0,0"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextAlignment="Center"/>

            <TextBlock x:Name="CameraStatusText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="20"
                       TextWrapping="Wrap"
                       MaxWidth="480"
                       TextAlignment="Center"
                       Visibility="Collapsed"/>

            <Grid x:Name="CameraProcessingOverlay"
                  Visibility="Collapsed"
                  Background="#AA000000">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <ProgressRing x:Name="CameraProcessingRing" IsActive="True" Width="48" Height="48" Foreground="White"/>
                    <TextBlock x:Name="CameraProcessingText"
                               Text="Elaborazione..."
                               Foreground="White"
                               FontSize="18"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border x:Name="CameraRecognitionBanner"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Margin="24,0,24,132"
                    Visibility="Collapsed"
                    Background="#CC2A1515"
                    BorderBrush="#FFE02424"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18,14">
                <TextBlock x:Name="CameraRecognitionBannerText"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"/>
            </Border>

            <Grid VerticalAlignment="Bottom" Padding="24,20" Background="#B3000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CameraCancelButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        MinHeight="56"
                        MinWidth="140"
                        Padding="24,12"
                        CornerRadius="28"
                        Background="#33FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Content="Indietro"
                        Click="CameraCancel_Click"/>

                <Button x:Name="CameraCaptureButton"
                        Grid.Column="1"
                        Width="88"
                        Height="88"
                        CornerRadius="44"
                        Background="White"
                        BorderBrush="#CCFFFFFF"
                        BorderThickness="4"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        Click="CameraCapture_Click"/>

                <Button x:Name="CameraManualButton"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinHeight="56"
                        MinWidth="220"
                        Padding="24,12"
                        CornerRadius="16"
                        Background="#33FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Content="Inserisci manualmente"
                        Click="CameraManualInsert_Click"/>

                <ProgressRing x:Name="CameraLoadingRing"
                              Grid.Column="1"
                              Width="48"
                              Height="48"
                              IsActive="True"/>
            </Grid>
        </Grid>

        <Grid x:Name="OfflineOverlay" Visibility="Collapsed" IsHitTestVisible="True">
            <Border>
                <Border.Background>
                    <AcrylicBrush TintColor="#111318" TintOpacity="0.82" FallbackColor="#D9111318"/>
                </Border.Background>
            </Border>
            <Grid x:Name="ConnectionOverlayPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="ConnectionOverlayContentPanel" Spacing="18" MaxWidth="520" Padding="24">
                    <FontIcon x:Name="ConnectionOverlayIcon" Glyph="&#xE701;" FontSize="72" Foreground="#FF848B96" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConnectionOverlayTitle"
                               Text="Connessione assente"
                               FontSize="26" FontWeight="Bold" Foreground="#FFE8EAED"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="ConnectionOverlayMessage"
                               Text="Connessione di rete non disponibile. L'app riprenderà automaticamente quando la connessione torna attiva."
                               FontSize="18" Foreground="#FF848B96" TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center" TextAlignment="Center" LineHeight="26"/>
                    <Button x:Name="ConnectionOverlayReloadButton"
                            Click="ConnectionOverlayReload_Click"
                            Visibility="Collapsed"
                            Height="56" MinWidth="240" Padding="24,0"
                            CornerRadius="12"
                            Background="#FF4D9EF7"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalAlignment="Center">
                        <TextBlock Text="Ricarica dataset" FontSize="18" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="ConnectionOverlayLoadingPanel"
                            Visibility="Collapsed"
                            Spacing="18"
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressRing x:Name="ConnectionOverlayLoadingRing" IsActive="True" Width="52" Height="52" Foreground="#FF4D9EF7"/>
                    <TextBlock x:Name="ConnectionOverlayLoadingText"
                               Text="Ricaricamento dataset in corso..."
                               FontSize="20" FontWeight="SemiBold" Foreground="#FFE8EAED"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
