<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brembana.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="24">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Spacing="28"
                    MaxWidth="980">
            <!-- Long-press 5s sul logo → menu amministratore kiosk -->
            <Image x:Name="AdminLogoHotspot"
                   Source="ms-appx:///Media/LogoBanner.png"
                   MaxHeight="88"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>

            <TextBlock Text="Cosa vuoi fare?"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#FFE8EAED"
                       HorizontalAlignment="Center"/>

            <Border Padding="10,8,14,12" HorizontalAlignment="Stretch">
                <StackPanel x:Name="HomeActionCardsHost"
                            HorizontalAlignment="Stretch"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
