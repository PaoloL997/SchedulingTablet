<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brembana.InventoryHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Brembana"
    Background="Transparent">

    <Page.Resources>
        <!-- I tab usano il nostro accento, non il blu di sistema. -->
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FF232830"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#FF2D333D"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#FF2D333D"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FF4D9EF7"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FF4D9EF7"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FF4D9EF7"/>
        <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FF848B96"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFE8EAED"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFE8EAED"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#FF3B424E"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#FF3B424E"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#FF3B424E"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#FF4D9EF7"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#FF4D9EF7"/>
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#FF4D9EF7"/>

        <Style x:Key="InvTypeTabStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InvRowStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- ATTENZIONE: le ColumnDefinitions e il Padding qui sotto devono restare
             identici a quelli di InvHeaderRow. WinUI non ha SharedSizeGroup (solo WPF),
             quindi l'allineamento tra intestazioni e celle è a carico nostro. -->
        <DataTemplate x:Key="InvRowTemplate" x:DataType="local:InventoryListRow">
            <Border BorderBrush="#FF3B424E" BorderThickness="0,0,0,1"
                    Padding="20,0,16,0" MinHeight="64" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="2.4*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind UidText, Mode=OneTime}"
                               FontSize="20" FontWeight="SemiBold" Foreground="#FFE8EAED"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind MeasureText, Mode=OneTime}"
                               FontSize="19" Foreground="#FFE8EAED"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind PlantText, Mode=OneTime}"
                               FontSize="19" Foreground="#FF848B96"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind ExtraText, Mode=OneTime}"
                               FontSize="18" Foreground="#FF848B96"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <!-- Pallino disponibilità: verde libera, rosso occupata. Il testo sta
                         nel tooltip, la cella resta una sola forma leggibile da lontano. -->
                    <Ellipse Grid.Column="4" Width="18" Height="18"
                             Fill="{x:Bind local:InventoryAvailabilityBrushes.For(IsAvailableToday), Mode=OneTime}"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             ToolTipService.ToolTip="{x:Bind AvailabilityText, Mode=OneTime}"/>
                    <TextBlock Grid.Column="5" Text="{x:Bind MaintenanceText, Mode=OneTime}"
                               FontSize="17" FontWeight="SemiBold" Foreground="#FFF29F0D"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0 · intestazione -->
        <Grid Grid.Row="0">
            <Button Click="Back_Click"
                    MinWidth="260"
                    Height="72"
                    HorizontalAlignment="Left"
                    CornerRadius="16"
                    BorderBrush="#FF3B424E"
                    BorderThickness="1"
                    Background="#FF232830"
                    ToolTipService.ToolTip="Torna alla home">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72B;" FontSize="28"/>
                    <TextBlock x:Name="BackButtonText" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="HubTitleText"
                       FontSize="28" FontWeight="Bold" Foreground="#FFE8EAED"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock x:Name="CountText"
                       FontSize="17" Foreground="#FF848B96"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 1 · tab per tipo -->
        <Grid x:Name="TypeTabsHost" Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Content e ordine arrivano da InventoryListing.Tabs: vedi ApplyTabLabels(). -->
            <ToggleButton Grid.Column="0" Tag="Generatore"
                          Style="{StaticResource InvTypeTabStyle}" Click="TypeTab_Click"/>
            <ToggleButton Grid.Column="1" Tag="Mandrino"
                          Style="{StaticResource InvTypeTabStyle}" Click="TypeTab_Click"/>
            <ToggleButton Grid.Column="2" Tag="Maschera"
                          Style="{StaticResource InvTypeTabStyle}" Click="TypeTab_Click"/>
            <ToggleButton Grid.Column="3" Tag="Tastatore"
                          Style="{StaticResource InvTypeTabStyle}" Click="TypeTab_Click"/>
            <ToggleButton Grid.Column="4" Tag="Testa"
                          Style="{StaticResource InvTypeTabStyle}" Click="TypeTab_Click"/>
        </Grid>

        <!-- 2 · ricerca -->
        <Border Grid.Row="2" Background="#FF232830" BorderBrush="#FF3B424E" BorderThickness="1"
                CornerRadius="16" Height="68" Padding="20,0" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="#FF848B96" VerticalAlignment="Center"/>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                                TextChanged="SearchBox_TextChanged"
                                Background="Transparent" BorderThickness="0"
                                FontSize="20" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3 · intestazioni di colonna — vedi la nota su InvRowTemplate -->
        <Grid x:Name="InvHeaderRow" Grid.Row="3" ColumnSpacing="12" Padding="20,0,16,0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HdrUid" Grid.Column="0" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF5C6370" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"/>
            <TextBlock x:Name="HdrMeasure" Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF5C6370" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"/>
            <TextBlock x:Name="HdrPlant" Grid.Column="2" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF5C6370" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"/>
            <TextBlock x:Name="HdrExtra" Grid.Column="3" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF5C6370" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"/>
            <TextBlock x:Name="HdrAvailability" Grid.Column="4" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF5C6370" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"/>
            <TextBlock x:Name="HdrStatus" Grid.Column="5" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF5C6370" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"/>
        </Grid>

        <!-- 4 · elenco virtualizzato -->
        <ListView x:Name="InventoryList" Grid.Row="4"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Padding="0"
                  ShowsScrollingPlaceholders="False"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ItemContainerStyle="{StaticResource InvRowStyle}"
                  ItemTemplate="{StaticResource InvRowTemplate}">
            <ListView.Resources>
                <!-- niente accento di sistema sulle righe -->
                <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#FF2D333D"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#FF2D333D"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF2D333D"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FF2D333D"/>
            </ListView.Resources>
        </ListView>

        <TextBlock x:Name="EmptyStateText" Grid.Row="4"
                   Visibility="Collapsed"
                   FontSize="18" Foreground="#FF848B96"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="WrapWholeWords" MaxWidth="520"/>

        <!-- 5 · le tre funzioni esistenti -->
        <Grid Grid.Row="5" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Le etichette arrivano dalle stesse costanti UiStrings usate come titolo
                 di sezione della fotocamera, così il tasto premuto e la schermata
                 successiva si leggono identici. -->
            <Button x:Name="MoveButton" Grid.Column="0" Click="Move_Click"
                    Height="80" HorizontalAlignment="Stretch" CornerRadius="16"
                    Background="#FF232830" BorderBrush="#FFF29F0D" BorderThickness="1">
                <TextBlock x:Name="MoveButtonText" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords" TextAlignment="Center"/>
            </Button>
            <Button x:Name="AddButton" Grid.Column="1" Click="Add_Click"
                    Height="80" HorizontalAlignment="Stretch" CornerRadius="16"
                    Background="#FF232830" BorderBrush="#FF4D9EF7" BorderThickness="1">
                <TextBlock x:Name="AddButtonText" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords" TextAlignment="Center"/>
            </Button>
            <Button x:Name="MaintenanceButton" Grid.Column="2" Click="Maintenance_Click"
                    Height="80" HorizontalAlignment="Stretch" CornerRadius="16"
                    Background="#FF232830" BorderBrush="#FF848B96" BorderThickness="1">
                <TextBlock x:Name="MaintenanceButtonText" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords" TextAlignment="Center"/>
            </Button>
        </Grid>
    </Grid>
</Page>
