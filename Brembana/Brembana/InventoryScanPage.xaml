<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brembana.InventoryScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Click="Back_Click"
                MinWidth="260"
                Height="72"
                HorizontalAlignment="Left"
                CornerRadius="16"
                BorderBrush="#FF3B424E"
                BorderThickness="1"
                Background="#FF232830"
                ToolTipService.ToolTip="Torna alla home">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE72B;" FontSize="28"/>
                <TextBlock Text="Torna alla home" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <TextBlock x:Name="SectionTitleText"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextAlignment="Center"/>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16">
            <ProgressRing x:Name="BusyRing"
                          IsActive="False"
                          Width="56"
                          Height="56"
                          HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusText"
                       Text="Apertura fotocamera..."
                       FontSize="24"
                       Foreground="#FF848B96"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
